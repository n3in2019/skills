     // Latest start wins; cancel suppresses publication, not queued work.
     // Each accepted operation may publish at most once.
     void start(int value) {
-        active_ = true;
-        queue_.post([this, value] {
-            if (!active_) return;
+        // Queued callbacks retain their identity, so it cannot be reused while
+        // stale work exists (unlike a wrapping generation counter).
+        auto operation = std::make_shared<const char>(0);
+        queue_.post([this, value, operation] {
+            if (active_operation_ != operation) return;
             published_.push_back(value);
-            active_ = false;
+            active_operation_.reset();
         });
+        // Only replace the active operation after posting succeeds.
+        active_operation_ = std::move(operation);
     }
-    void cancel() { active_ = false; }
+    void cancel() { active_operation_.reset(); }
     const std::vector<int>& published() const { return published_; }
 private:
     ManualQueue& queue_;
-    bool active_ = false;
+    std::shared_ptr<const char> active_operation_;
     std::vector<int> published_;
 };
