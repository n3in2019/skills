+    { ManualQueue q; Session s(q); s.start(7); s.start(8);
+      q.complete(0);
+      check(s.published().empty());
+      q.complete(1);
+      check(s.published() == std::vector<int>{8}); }
+    // A callback that already published cannot publish again during a new start.
