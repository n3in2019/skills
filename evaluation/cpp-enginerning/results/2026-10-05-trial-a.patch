--- before/lifetime.hpp
+++ after/lifetime.hpp
@@ -22,15 +22,27 @@
 private:
     Trace& trace_;
 };
-inline int process(Trace& trace, int input, bool fail_dispatch) {
-    Lease lease(trace);
-    trace.events.push_back("validate");
-    if (input < 0) return -1;
+namespace dispatch_detail {
+inline int prepare(Trace& trace, int input) {
     const int prepared = input + 1; // contract: input <= 1000
     trace.events.push_back("prepare");
+    return prepared;
+}
+
+inline void dispatch(Trace& trace, bool fail_dispatch) {
     if (!trace.active) throw std::logic_error("inactive lease");
     trace.events.push_back("dispatch");
     if (fail_dispatch) throw std::runtime_error("dispatch failed");
     trace.events.push_back("complete");
+}
+} // namespace dispatch_detail
+
+inline int process(Trace& trace, int input, bool fail_dispatch) {
+    // The lease spans preparation and dispatch, including exception unwinding.
+    Lease lease(trace);
+    trace.events.push_back("validate");
+    if (input < 0) return -1;
+    const int prepared = dispatch_detail::prepare(trace, input);
+    dispatch_detail::dispatch(trace, fail_dispatch);
     return prepared;
 }
